# Valores locales de ejemplo. deploy.ps1 genera secretos aleatorios en .env.
DJANGO_SECRET_KEY=change-this-local-secret
DJANGO_DEBUG=False
DB_NAME=synthgroove
DB_USER=synthgroove
DB_PASSWORD=change-this-local-database-password
DB_PORT=3306
# Opcional: sin estas credenciales se guardan los archivos en backend/media.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
